FROM php:8.2-apache

# Install system dependencies for GD, zip, and PHP extensions
RUN apt-get update && apt-get install -y \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libzip-dev \
        zlib1g-dev \
        zip \
        unzip \
        git \
        curl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install gd mysqli zip \
    && a2enmod rewrite

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html/

# Copy project files
COPY . /var/www/html/

# Ensure PHP CLI sees GD
RUN php -m | grep -i gd

# Run Composer install after GD is available
RUN composer install --ignore-platform-reqs --optimize-autoloader --no-scripts --no-interaction

EXPOSE 80